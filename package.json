{
  "name": "sacm",
  "version": "2.0.0",
  "private": true,
  "description": "SACM - Sistema de Análisis y Control de Malware: análisis estático, inteligencia de amenazas y analítica para equipos de seguridad",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:seed:demo": "node scripts/seed.js --demo",
    "db:setup": "node scripts/migrate.js && node scripts/seed.js",
    "db:import-legacy": "node scripts/import-legacy.js",
    "user:create": "node scripts/create-user.js",
    "user:reset-password": "node scripts/reset-password.js",
    "samples:analyze": "node scripts/analyze-samples.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "keywords": [
    "malware",
    "ciberseguridad",
    "threat-intelligence",
    "virustotal",
    "mitre-attack",
    "express",
    "mysql"
  ],
  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  }
}
