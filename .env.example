# Copia este archivo como .env y completa tus valores

# ===== Servidor =====
NODE_ENV=development
PORT=5000

# ===== Base de datos =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=sacm_v2
# Base de datos de la versión 1 (solo para npm run db:import-legacy)
LEGACY_DB_NAME=sacm

# ===== Seguridad =====
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h
MAX_UPLOAD_MB=32

# ===== Inteligencia de amenazas (opcional, todas tienen plan gratuito) =====
# https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
# true = sube a VirusTotal los archivos que no conoce (quedan visibles para su comunidad)
VIRUSTOTAL_UPLOAD_UNKNOWN=false
# https://auth.abuse.ch/ (sirve para MalwareBazaar y URLhaus)
ABUSECH_AUTH_KEY=
# CIRCL hashlookup es público y no necesita clave
CIRCL_HASHLOOKUP_ENABLED=true
